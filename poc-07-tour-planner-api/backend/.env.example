# API Keys - REQUIRED
GROQ_API_KEY=your_groq_api_key_here        # Required for Whisper STT and sub-agents
GOOGLE_API_KEY=your_google_api_key_here    # Required for coordinator agent (Gemini)
OPENAI_API_KEY=your_openai_api_key_here    # Required for Text-to-Speech (voice features)

# Optional: Database URL (for DatabaseSessionService in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/tourplanner

# Optional: CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional: API Server Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=info
